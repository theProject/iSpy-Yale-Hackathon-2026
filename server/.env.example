# Environment variables for iSpy backend
# Copy this file to .env and fill in your values

# Camera source (0=default, 1=external, or URL for IP camera)
CAMERA_SOURCE=1

# Gemini API key for AI vision processing
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Google Cloud TTS credentials (JSON file path)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service_account.json

# Optional: Vosk model path (defaults to models/vosk-model-small-en-us-0.15)
# VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15